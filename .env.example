# Copier ce fichier en .env.local et remplir les valeurs (ne jamais committer .env.local).
# En ligne, ces variables sont réglées dans Vercel → Settings → Environment Variables (Production + Preview).

# Supabase — Project Settings > API Keys. Valeurs publiques : la sécurité repose sur la RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clé secrète Supabase (serveur uniquement, lecture des possessions du propriétaire pour /api/suivi).
# SUPABASE_SECRET_KEY=

# Suivi externe (GET /api/suivi, appelé par mon-site-sdlc) — jeton secret partagé, serveur uniquement.
# SUIVI_API_TOKEN=

# Adresse publique du site (optionnel, par défaut https://dragonball-db.vercel.app).
# NEXT_PUBLIC_SITE_URL=https://dragonball-db.vercel.app
